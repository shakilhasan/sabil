# ─── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_GATEWAY_PORT=3000

# ─── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Master MySQL Database ───────────────────────────────────────────
MASTER_DB_HOST=localhost
MASTER_DB_PORT=3306
MASTER_DB_USERNAME=saas_admin
MASTER_DB_PASSWORD=saas_password
MASTER_DB_NAME=school_saas_master

# ─── Tenant MySQL Database Template ─────────────────────────────────
# Each tenant gets their own DB: school_{tenant_slug}
TENANT_DB_HOST=localhost
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=saas_admin
TENANT_DB_PASSWORD=saas_password

# ─── Kafka ───────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=school-management-saas
KAFKA_GROUP_ID_PREFIX=school-saas

# ─── Super Admin Seed ────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@school-saas.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123
